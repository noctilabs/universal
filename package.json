{
  "name": "universal-monorepo",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "packages/*",
    "backend",
    "storefront"
  ],
  "scripts": {
    "build": "yarn build:types && yarn build:backend",
    "build:types": "yarn workspace @universal/types run build",
    "build:backend": "yarn workspace universal run build",
    "start:backend": "yarn workspace universal run start",
    "migrate:backend": "yarn workspace universal run medusa db:migrate",
    "start:backend:compiled": "cd backend/.medusa/server && node ../../node_modules/@medusajs/cli/cli.js start"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "typescript": "^5.9.3"
  }
}
